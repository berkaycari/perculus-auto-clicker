{
  "manifest_version": 3,
  "name": "Perculus Buradayım Otomatik Tıklama",
  "version": "1.1.0",
  "description": "Perculus sayfasında “Buradayım!” butonu göründüğünde otomatik tıklar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.perculus6.com/*",
        "*://*.perculus.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
